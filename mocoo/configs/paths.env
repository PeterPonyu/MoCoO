# ── MoCoO path configuration ─────────────────────────────────────────────
# This file is sourced by the top-level Makefile via Make's `-include`.
# Use Make variable syntax (VAR ?= value).  The ?= operator means
# "set only if not already defined", so environment variables and
# command-line overrides always take precedence.
#
# To customise, copy this file or edit in place.  The Makefile will
# work without it (defaults are baked in), but having it keeps all
# path decisions in one place.
# ─────────────────────────────────────────────────────────────────────────

# Base directory where raw .h5ad datasets live.
# The DatasetRegistry resolves paths relative to this root.
MOCOO_DATA_DIR   ?= /home/zeyufu

# Benchmark output directories (relative to project root).
MOCOO_RESULTS_DIR ?= benchmarks/results
MOCOO_FIGURES_DIR ?= benchmarks/figures
MOCOO_PAPER_DIR   ?= paper
